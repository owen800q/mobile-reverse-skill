__pycache__/
*.pyc
.DS_Store
re_out/

# KB search index: index.pkl is 21 MB and rebuilds locally in ~5s, so it is not
# tracked. embeddings.npy (~1 MB) IS tracked - it needs torch + ~90s to produce
# and is rebuilt by .github/workflows/kb-index.yml when kb/articles/** changes.
skills/reverse-skill/kb/index/index.pkl
skills/reverse-skill/kb/index/fingerprint.txt

# kanxue crawler: a logged-in cookie jar and a Chromium profile - never commit these.
# output/*.json IS tracked (it is the resume state the daily crawl depends on), but
# output/articles/ is not: kb/articles/ is the canonical copy of the same markdown.
tools/kanxue-crawler/.session-state.json
tools/kanxue-crawler/.browser-profile/
tools/kanxue-crawler/output/articles/

# CloakBrowser CI: key-gated archives, extracted binaries, profiles and logs.
# Only the hash-guarded tooling and patch specification are tracked.
tools/cloakbrowser-ci/runtime/
skills/reverse-skill/const_fingerprints.json
skills/reverse-skill/crypto_instr.json
